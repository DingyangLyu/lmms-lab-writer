# Set these in your shell for native execution, or in the root .env for Docker Compose.
WRITER_ADMIN_USER=writer
WRITER_ADMIN_PASSWORD=
WRITER_ORIGIN=http://127.0.0.1:8787
# Public HTTPS through the bundled Caddy (docker compose --profile https up -d), see
# docs/deploy-windows.md: the domain, the origin users open, and trust in the proxy's headers.
# WRITER_DOMAIN=writer.example.com
# WRITER_ORIGIN=https://writer.example.com
# WRITER_TRUST_PROXY=1
WRITER_PORT=8787
# Docker Compose: password of the bundled PostgreSQL (letters and digits only, used in a URL).
WRITER_POSTGRES_PASSWORD=
# WRITER_BACKUP_KEEP_DAYS=14
# Native server: a PostgreSQL URL. Unset = embedded PostgreSQL (PGlite) in WRITER_DATA_DIR,
# fine for trying Writer alone; use a real server for a lab.
# WRITER_DATABASE_URL=postgres://writer:password@127.0.0.1:5432/writer
WRITER_DATA_DIR=.data
# Browser builds: latexmk on the server (the Docker image includes TeX Live).
# WRITER_LATEXMK=latexmk
# WRITER_COMPILE_TIMEOUT=120
# WRITER_COMPILE_CONCURRENCY=2
# WRITER_TEXMFVAR=/var/cache/writer-texmf
# Extra project templates (one folder per template with a template.json; see
# docs/research-tools-and-collaboration.md), added to the built-in ones.
# WRITER_TEMPLATES_DIR=
# Desktop installers offered on the Desktop page (a GitHub release's .pkg/.dmg/.exe/.msi/
# .AppImage/.deb/.rpm files). Default: WRITER_DATA_DIR/downloads.
# WRITER_DOWNLOADS_DIR=
# A runner shared with every project on this server, e.g. a lab machine with Codex/OpenCode
# signed in to the lab's account (generate with: openssl rand -hex 32). Run `pnpm runner` on
# that machine with WRITER_RUNNER_TOKEN set to the same value.
# WRITER_SHARED_RUNNER_TOKEN=
# WRITER_SHARED_RUNNER_NAME=Lab machine
# WRITER_SHARED_RUNNER_HARNESSES=codex,opencode
# A separate trusted local runner (never publish this project-specific token):
# WRITER_SERVER=http://127.0.0.1:8787
# WRITER_RUNNER_TOKEN=
# WRITER_ALLOWED_HARNESSES=compile
# Codex sandbox for runner tasks (workspace-write by default). danger-full-access gives the
# agent this account's full access; only for a machine where Codex's sandbox cannot run.
# WRITER_CODEX_SANDBOX=workspace-write
# Optional: choose models explicitly supported by each local CLI/account.
# WRITER_CODEX_MODEL=
# WRITER_CLAUDE_MODEL=
# WRITER_OPENCODE_MODEL=
