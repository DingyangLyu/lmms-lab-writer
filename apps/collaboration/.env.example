# Set these in your shell for native execution, or in the root .env for Docker Compose.
WRITER_ADMIN_USER=writer
WRITER_ADMIN_PASSWORD=
WRITER_ORIGIN=http://127.0.0.1:8787
WRITER_PORT=8787
# Docker Compose: password of the bundled PostgreSQL (letters and digits only, used in a URL).
WRITER_POSTGRES_PASSWORD=
# WRITER_BACKUP_KEEP_DAYS=14
# Native server: a PostgreSQL URL. Unset = embedded PostgreSQL (PGlite) in WRITER_DATA_DIR,
# fine for trying Writer alone; use a real server for a lab.
# WRITER_DATABASE_URL=postgres://writer:password@127.0.0.1:5432/writer
WRITER_DATA_DIR=.data
# A separate trusted local runner (never publish this project-specific token):
# WRITER_SERVER=http://127.0.0.1:8787
# WRITER_RUNNER_TOKEN=
# WRITER_ALLOWED_HARNESSES=compile
# Optional: choose models explicitly supported by each local CLI/account.
# WRITER_CODEX_MODEL=
# WRITER_CLAUDE_MODEL=
# WRITER_OPENCODE_MODEL=
